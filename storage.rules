rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // 작가 미디어 파일: 읽기 공개, 쓰기는 본인 또는 관리자
    match /artists/{artistId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
        && (request.auth.uid == artistId || isAdmin())
        && request.resource.size < 20 * 1024 * 1024  // 20MB 제한
        && request.resource.contentType.matches('image/.*');
    }

    // QR 코드 (관리자만 생성)
    match /qrcodes/{filename} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    function isAdmin() {
      return firestore.exists(
        /databases/(default)/documents/admins/$(request.auth.uid)
      );
    }
  }
}
